{
  "name": "irit",
  "displayName": "irit (caveman-indonesia)",
  "version": "0.3.1",
  "description": "Caveman-style terse replies for Indonesian. Modes: singkat, jaksel, sunda. About 65% fewer output tokens.",
  "author": {
    "name": "Rivo Rumadi",
    "url": "https://github.com/Leon24k"
  },
  "homepage": "https://leon24k.github.io/caveman-indonesia/",
  "repository": "https://github.com/Leon24k/caveman-indonesia",
  "license": "MIT",
  "keywords": [
    "caveman",
    "indonesia",
    "token-optimization",
    "jaksel",
    "sunda",
    "skills"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/irit.js\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/irit.js\" prompt",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
